{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "types": ["bun", "node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
