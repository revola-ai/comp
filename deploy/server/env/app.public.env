# Non-secret values of the app container, appended by render-env.sh to /opt/comp/env/app.env.
# Committed on purpose: no value here is secret. NEXT_PUBLIC_* values are compiled into the
# image (deploy/aws/public-env.ts), so they are not repeated here.
NODE_ENV=production
DATABASE_SSL_CA=/app/certs/supabase-ca.crt
DATABASE_POOL_MAX=2
# Server-side calls reach the API over the compose network, not through the tunnel.
BACKEND_API_URL=http://api:3333
