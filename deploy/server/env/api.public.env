# Non-secret values of the api container, appended by render-env.sh to /opt/comp/env/api.env.
# Committed on purpose: no value here is secret. Written verbatim (compose reads it as raw).
NODE_ENV=production
DATABASE_SSL_CA=/app/certs/supabase-ca.crt
# Connection budget: api 4, app 2, portal 1 (deploy/server/README.md, "Connection budget").
DATABASE_POOL_MAX=4
SELF_HOSTED=true
NEXT_PUBLIC_SELF_HOSTED=true
AUTH_COOKIE_DOMAIN=.comp.revola.ai
AUTH_TRUSTED_ORIGINS=https://app.comp.revola.ai,https://portal.comp.revola.ai,https://api.comp.revola.ai
# Sign-in is limited to the same domain as the Cloudflare Access staff policy.
AUTH_ALLOWED_EMAIL_DOMAINS=revola.ai
BASE_URL=https://api.comp.revola.ai
# Where integration OAuth callbacks send the browser back to.
APP_URL=https://app.comp.revola.ai
# TrustAccessService refuses to boot in production without TRUST_APP_URL or PORTAL_URL.
PORTAL_URL=https://portal.comp.revola.ai
NEXT_PUBLIC_APP_URL=https://app.comp.revola.ai
# One-click List-Unsubscribe headers point at the API.
NEXT_PUBLIC_API_URL=https://api.comp.revola.ai
NEXT_PUBLIC_PORTAL_URL=https://portal.comp.revola.ai
# CF-Connecting-IP is trusted only from the cloudflared container's static address
# (compose.yaml, services.cloudflared.networks.comp.ipv4_address).
TRUSTED_EDGE_PROXY_IPS=172.30.0.10
