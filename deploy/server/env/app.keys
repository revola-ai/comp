# Secret keys of the app container, read from comp/production/config by render-env.sh.
# One per line: NAME, or "NAME from KEY" when the container variable is named differently
# from the key in the secret. Names only; values never go in this repository.
DATABASE_URL
APP_AWS_ENDPOINT
APP_AWS_REGION
APP_AWS_ACCESS_KEY_ID
APP_AWS_SECRET_ACCESS_KEY
APP_AWS_BUCKET_NAME
APP_AWS_ORG_ASSETS_BUCKET
UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN
RESEND_API_KEY
COMP_FORWARDED_IP_TOKEN
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET
APP_AWS_KNOWLEDGE_BASE_BUCKET
SECRET_KEY
ENCRYPTION_KEY
# The app reads the Google pair only to decide whether to show the Google button.
AUTH_GOOGLE_ID
AUTH_GOOGLE_SECRET
RESEND_FROM_SYSTEM
RESEND_FROM_DEFAULT
UNSUBSCRIBE_SECRET
OPENAI_API_KEY
ANTHROPIC_API_KEY
# better-auth names the shared secret AUTH_SECRET in the app.
AUTH_SECRET from SECRET_KEY
GOOGLE_GENERATIVE_AI_API_KEY
REVALIDATION_SECRET
TRIGGER_SECRET_KEY from TRIGGER_SECRET_KEY_APP
