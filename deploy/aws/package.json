{
  "name": "@trycompai/deploy-aws",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && find . -name '*.sh' -not -path './node_modules/*' -not -path './terraform/.terraform/*' -print0 | xargs -0 -r shellcheck -S warning",
    "test": "bun test && for f in tests/*.test.sh; do [ -e \"$f\" ] || continue; bash \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@trycompai/tsconfig": "workspace:*",
    "@types/bun": "^1.3.14",
    "eslint": "^9.18.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
